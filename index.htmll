<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>پژوهش سرای دانش‌آموزی امام علی (ع) سنقر</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<style>
@import url('https://fonts.googleapis.com/css2?family=Vazirmatn:wght@300;400;500;600;700;800;900&display=swap');

*{margin:0;padding:0;box-sizing:border-box}

:root{
--primary:#0a2463;--primary-light:#1e3a8a;--primary-dark:#051a3e;
--gold:#d4a574;--gold-light:#f0d5b0;
--white:#fff;--gray-light:#f1f5f9;--gray:#e2e8f0;
--text-dark:#0f172a;--text-muted:#64748b;
--shadow:0 10px 40px rgba(10,36,99,.08);
--shadow-hover:0 20px 60px rgba(10,36,99,.15);
--radius:24px;
--transition:all .4s cubic-bezier(.4,0,.2,1);
--bg-card:rgba(255,255,255,.7);
--border-card:rgba(255,255,255,.4);
--text-color:#0f172a;
--text-muted-color:#64748b;
--footer-bg:#051a3e;
}

[data-theme=dark]{
--primary:#8b5cf6;--primary-light:#a78bfa;--primary-dark:#4c1d95;
--gold:#fbbf24;--gold-light:#fcd34d;
--gray-light:#181825;--gray:#2d2d44;
--text-dark:#e8e8f0;--text-muted:#a0a0b8;
--bg-card:rgba(30,30,46,.8);
--border-card:rgba(255,255,255,.1);
--text-color:#e8e8f0;
--text-muted-color:#a0a0b8;
--footer-bg:#0f0f1a;
}

html{scroll-behavior:smooth}

body{
font-family:'Vazirmatn',Tahoma,sans-serif;
background:var(--gray-light);
color:var(--text-color);
line-height:1.8;
direction:rtl;
transition:background .4s,color .4s;
}

.container{max-width:1200px;margin:0 auto;padding:0 1.5rem}

/* ===== نوار بالایی ===== */
.top-bar{
background:var(--footer-bg);color:#fff;
padding:.3rem 1.5rem;
display:flex;justify-content:space-between;align-items:center;
font-size:.6rem;flex-wrap:wrap;gap:.5rem;
}
.top-bar .contact-info{display:flex;gap:1.2rem;flex-wrap:wrap}
.top-bar .contact-info span{opacity:.85;display:flex;align-items:center;gap:.3rem}
.top-bar .social-links a{
color:#fff;text-decoration:none;margin-right:.8rem;
opacity:.7;transition:var(--transition);font-size:.9rem;
}
.top-bar .social-links a:hover{opacity:1;color:var(--gold)}

/* ===== هدر ===== */
.header{
background:var(--bg-card);
backdrop-filter:blur(20px);
border-bottom:1px solid var(--border-card);
padding:.6rem 1.5rem;
position:sticky;top:0;z-index:1000;
display:flex;justify-content:space-between;align-items:center;
flex-wrap:wrap;gap:.8rem;
}
.header .logo{display:flex;align-items:center;gap:.8rem;text-decoration:none}
.header .logo .logo-icon{
width:48px;height:48px;
background:linear-gradient(135deg,var(--primary),var(--primary-light));
border-radius:14px;
display:flex;align-items:center;justify-content:center;
color:var(--gold);font-size:1.5rem;font-weight:900;
box-shadow:0 4px 15px rgba(10,36,99,.25);flex-shrink:0;
}
.header .logo h1{font-size:1.1rem;font-weight:800;color:var(--primary);line-height:1.2}
.header .logo h1 small{display:block;font-size:.5rem;font-weight:400;color:var(--text-muted-color)}

.nav-menu{display:flex;gap:.2rem;flex-wrap:wrap;align-items:center}
.nav-menu a{
text-decoration:none;color:var(--text-color);
font-size:.65rem;font-weight:600;
padding:.4rem .9rem;border-radius:50px;
transition:var(--transition);white-space:nowrap;
}
.nav-menu a:hover,.nav-menu a.active{background:var(--primary);color:#fff}
.nav-menu a.cta-btn{
background:linear-gradient(135deg,var(--gold),#c9956b);
color:var(--primary-dark);padding:.4rem 1.4rem;font-weight:700;
box-shadow:0 4px 15px rgba(212,165,116,.35);
}

.menu-toggle{
display:none;font-size:1.6rem;background:0 0;border:none;
color:var(--primary);cursor:pointer;padding:.2rem .5rem;
}

.settings-group{display:flex;gap:.3rem;align-items:center;flex-wrap:wrap}
.settings-btn{
background:var(--bg-card);border:1px solid var(--border-card);
color:var(--text-color);padding:.25rem .6rem;border-radius:50px;
font-size:.6rem;cursor:pointer;transition:var(--transition);
font-family:'Vazirmatn',Tahoma,sans-serif;
display:flex;align-items:center;gap:.2rem;
}
.settings-btn:hover,.settings-btn.active{background:var(--primary);color:#fff;border-color:var(--primary)}

/* ===== بنر ===== */
.hero{
background:linear-gradient(135deg,var(--primary-dark)0%,var(--primary)50%,var(--primary-light)100%);
padding:3rem 1.5rem;text-align:center;
position:relative;overflow:hidden;
}
.hero .hero-content{position:relative;z-index:2;max-width:800px;margin:0 auto}
.hero .badge{
display:inline-block;
background:rgba(212,165,116,.15);
border:1px solid rgba(212,165,116,.3);
color:var(--gold-light);font-size:.6rem;font-weight:700;
padding:.25rem 1.5rem;border-radius:50px;margin-bottom:.8rem;
backdrop-filter:blur(10px);
}
.hero h1{font-size:2.2rem;font-weight:700;color:#fff;margin-bottom:.4rem;line-height:1.3}
.hero h1 span{color:var(--gold-light)}
.hero p{color:rgba(255,255,255,.85);font-size:.85rem;max-width:600px;margin:0 auto 1.2rem;line-height:2}
.hero .hero-btns{display:flex;gap:.8rem;justify-content:center;flex-wrap:wrap}
.hero .hero-btns .btn-primary{
background:var(--gold);color:var(--primary-dark);
padding:.5rem 2rem;border-radius:50px;text-decoration:none;
font-weight:700;font-size:.75rem;transition:var(--transition);
box-shadow:0 4px 25px rgba(212,165,116,.35);
}
.hero .hero-btns .btn-primary:hover{transform:translateY(-3px);box-shadow:0 8px 40px rgba(212,165,116,.5)}
.hero .hero-btns .btn-outline{
background:transparent;border:2px solid rgba(255,255,255,.3);
color:#fff;padding:.5rem 2rem;border-radius:50px;
text-decoration:none;font-weight:600;font-size:.75rem;transition:var(--transition);
}
.hero .hero-btns .btn-outline:hover{background:rgba(255,255,255,.1);border-color:#fff}

/* ===== بخش‌ها ===== */
.section{padding:3rem 0;position:relative;border-bottom:1px solid var(--border-card)}
.section:last-of-type{border-bottom:none}
.section-header{text-align:center;margin-bottom:2rem}
.section-header h2{
font-size:1.5rem;font-weight:800;color:var(--primary);
display:flex;align-items:center;justify-content:center;gap:.5rem;
}
.section-header h2 span{color:var(--gold)}
.section-header p{color:var(--text-muted-color);font-size:.7rem;margin-top:.2rem}

/* ===== دکمه باز/بسته ===== */
.toggle-btn{
display:inline-flex;align-items:center;gap:.5rem;
background:var(--primary);color:#fff;
padding:.5rem 1.8rem;border-radius:50px;border:none;
font-size:.75rem;font-weight:700;cursor:pointer;
transition:var(--transition);
font-family:'Vazirmatn',Tahoma,sans-serif;
margin:0 auto 1rem;box-shadow:0 4px 20px rgba(10,36,99,.3);
}
.toggle-btn:hover{transform:translateY(-3px);box-shadow:0 8px 30px rgba(10,36,99,.4)}
.toggle-btn i{transition:transform .4s}
.toggle-btn.active i{transform:rotate(180deg)}
.toggle-content{display:none;animation:slideDown .4s ease}
.toggle-content.open{display:block}
@keyframes slideDown{from{opacity:0;transform:translateY(-15px)}to{opacity:1;transform:translateY(0)}}

/* ===== کارت‌ها ===== */
.glass-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:1.2rem}
.glass-card{
background:var(--bg-card);backdrop-filter:blur(20px);
border:1px solid var(--border-card);border-radius:var(--radius);
padding:1.2rem .6rem;text-align:center;text-decoration:none;
color:var(--text-color);transition:var(--transition);
box-shadow:var(--shadow);position:relative;overflow:hidden;
}
.glass-card:hover{transform:translateY(-6px) scale(1.02);box-shadow:var(--shadow-hover);border-color:var(--primary)}
.glass-card .card-icon{font-size:2rem;display:block;margin-bottom:.3rem}
.glass-card h3{font-size:.6rem;font-weight:700;color:var(--primary)}

/* ===== قطب‌ها ===== */
.pole-item{
background:var(--bg-card);backdrop-filter:blur(20px);
border:1px solid var(--border-card);border-radius:var(--radius);
padding:1rem;margin-bottom:.8rem;transition:var(--transition);
box-shadow:var(--shadow);
}
.pole-item .pole-header{display:flex;align-items:center;justify-content:space-between;cursor:pointer;padding:.2rem .3rem}
.pole-item .pole-header .pole-title{font-size:.75rem;font-weight:700;color:var(--primary);display:flex;align-items:center;gap:.5rem}
.pole-item .pole-header .toggle-icon{font-size:.8rem;color:var(--text-muted-color);transition:transform .4s}
.pole-item.open .toggle-icon{transform:rotate(180deg)}
.pole-item .pole-links{display:none;padding-top:.8rem;border-top:1px solid var(--border-card);margin-top:.6rem;gap:.5rem;flex-wrap:wrap}
.pole-item.open .pole-links{display:flex}
.pole-link{
display:inline-flex;align-items:center;gap:.3rem;
padding:.3rem 1rem;background:var(--primary);color:#fff;
border-radius:50px;text-decoration:none;font-size:.5rem;font-weight:600;
transition:var(--transition);
}
.pole-link:hover{transform:translateY(-2px);box-shadow:0 4px 15px rgba(10,36,99,.3)}
.pole-link.blue{background:#1e3a8a}
.pole-link.green{background:#10b981}
.pole-link.purple{background:#7c3aed}

/* ===== اخبار ===== */
.news-highlight{
background:linear-gradient(135deg,var(--primary-dark),var(--primary));
border-radius:var(--radius);padding:1.5rem;
box-shadow:0 10px 40px rgba(10,36,99,.2);margin-bottom:1.5rem;
}
.news-highlight .section-header h2{color:#fff}
.news-highlight .section-header h2 span{color:var(--gold-light)}
.news-highlight .section-header p{color:rgba(255,255,255,.7)}
.news-slider{display:flex;overflow-x:auto;gap:1.2rem;padding:.8rem .2rem 1.2rem;scroll-snap-type:x mandatory}
.news-slider::-webkit-scrollbar{height:4px}
.news-slider::-webkit-scrollbar-thumb{background:var(--gold);border-radius:4px}
.news-card{
min-width:240px;max-width:300px;flex-shrink:0;scroll-snap-align:start;
background:rgba(255,255,255,.12);backdrop-filter:blur(20px);
border:1px solid rgba(255,255,255,.15);border-radius:var(--radius);
padding:1.2rem;transition:var(--transition);cursor:pointer;color:#fff;
}
.news-card:hover{transform:translateY(-6px);background:rgba(255,255,255,.2);border-color:var(--gold);box-shadow:0 20px 50px rgba(0,0,0,.3)}
.news-card .news-img{width:100%;height:100px;border-radius:12px;object-fit:cover;margin-bottom:.6rem}
.news-card .news-badge{
display:inline-block;font-size:.4rem;font-weight:700;
color:var(--gold-light);background:rgba(212,165,116,.2);
padding:.1rem .8rem;border-radius:50px;margin-bottom:.4rem;
border:1px solid rgba(212,165,116,.2);
}
.news-card h3{font-size:.8rem;font-weight:800;color:#fff;margin-bottom:.3rem;line-height:1.5}
.news-card p{font-size:.55rem;color:rgba(255,255,255,.7);line-height:1.7;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.news-card .news-meta{display:flex;justify-content:space-between;align-items:center;margin-top:.5rem;padding-top:.5rem;border-top:1px solid rgba(255,255,255,.08)}
.news-card .news-meta .date{font-size:.4rem;color:rgba(255,255,255,.5)}
.news-card .news-meta .more{font-size:.45rem;color:var(--gold-light);font-weight:700}

/* ===== کتاب امروز ===== */
.book-day-section{
padding:2.5rem 0;
background:linear-gradient(135deg,rgba(10,36,99,.03),rgba(212,165,116,.05));
border-radius:var(--radius);margin:1.5rem 0;
position:relative;overflow:hidden;
}
.book-day-section::before{
content:'';position:absolute;top:-50%;right:-20%;
width:400px;height:400px;
background:radial-gradient(circle,rgba(212,165,116,.15),transparent 70%);
border-radius:50%;animation:floatBook 20s ease-in-out infinite;
pointer-events:none;
}
.book-day-section::after{
content:'';position:absolute;bottom:-50%;left:-20%;
width:300px;height:300px;
background:radial-gradient(circle,rgba(10,36,99,.1),transparent 70%);
border-radius:50%;animation:floatBook 25s ease-in-out infinite reverse;
pointer-events:none;
}
@keyframes floatBook{0%,100%{transform:translate(0,0) scale(1)}50%{transform:translate(30px,-30px) scale(1.1)}}

.book-icon-3d{
width:120px;height:120px;margin:0 auto 1rem;
position:relative;perspective:800px;
display:flex;align-items:center;justify-content:center;
}
.book-icon-3d .book{
width:80px;height:100px;position:relative;
transform-style:preserve-3d;animation:bookFloat 4s ease-in-out infinite;
}
@keyframes bookFloat{0%,100%{transform:translateY(0) rotateY(-15deg)}50%{transform:translateY(-12px) rotateY(-25deg)}}
.book-icon-3d .book .cover{
position:absolute;width:100%;height:100%;
background:linear-gradient(135deg,#0a2463,#1e3a8a,#d4a574);
border-radius:6px 14px 14px 6px;
box-shadow:0 20px 40px rgba(10,36,99,.4),inset 0 0 30px rgba(212,165,116,.3);
display:flex;flex-direction:column;align-items:center;justify-content:center;
color:#f0d5b0;font-size:2rem;overflow:hidden;
border:1px solid rgba(212,165,116,.4);
}
.book-icon-3d .book .cover::before{
content:'';position:absolute;top:0;left:0;
width:8px;height:100%;
background:linear-gradient(90deg,#d4a574,#f0d5b0,#d4a574);
box-shadow:2px 0 8px rgba(0,0,0,.3);
}
.book-icon-3d .book .cover::after{
content:'📖';font-size:2.5rem;
filter:drop-shadow(0 0 10px rgba(212,165,116,.8));
animation:bookGlow 2s ease-in-out infinite;
}
@keyframes bookGlow{0%,100%{filter:drop-shadow(0 0 10px rgba(212,165,116,.8))}50%{filter:drop-shadow(0 0 25px rgba(212,165,116,1))}}
.book-icon-3d .halo{
position:absolute;width:140px;height:140px;border-radius:50%;
background:radial-gradient(circle,rgba(212,165,116,.3),transparent 70%);
animation:haloRotate 8s linear infinite;
}
@keyframes haloRotate{from{transform:rotate(0deg)}to{transform:rotate(360deg)}}

.book-day-card{
background:var(--bg-card);backdrop-filter:blur(20px);
border:1px solid var(--border-card);border-radius:var(--radius);
padding:2rem;text-align:center;max-width:700px;margin:0 auto;
box-shadow:0 20px 60px rgba(10,36,99,.15);
position:relative;overflow:hidden;transition:var(--transition);
animation:cardEnter .6s ease;
}
.book-day-card:hover{transform:translateY(-5px);box-shadow:0 30px 80px rgba(10,36,99,.25);border-color:var(--gold)}
@keyframes cardEnter{from{opacity:0;transform:translateY(30px) scale(.95)}to{opacity:1;transform:translateY(0) scale(1)}}
.book-day-card .book-category{
display:inline-block;font-size:.55rem;font-weight:700;
color:var(--gold);background:rgba(212,165,116,.1);
padding:.2rem 1rem;border-radius:50px;
border:1px solid rgba(212,165,116,.3);margin-bottom:.8rem;
}
.book-day-card .book-title{font-size:1.4rem;font-weight:900;color:var(--primary);margin-bottom:.3rem;line-height:1.5}
.book-day-card .book-author{font-size:.7rem;color:var(--text-muted-color);font-weight:600;margin-bottom:.8rem}
.book-day-card .book-desc{
font-size:.75rem;line-height:2;color:var(--text-color);
margin-bottom:1.2rem;padding:.8rem;
background:rgba(10,36,99,.03);border-radius:12px;
border-right:3px solid var(--gold);
}
.book-day-card .book-actions{display:flex;gap:.6rem;justify-content:center;flex-wrap:wrap}
.book-day-card .book-actions a{
display:inline-flex;align-items:center;gap:.3rem;
padding:.4rem 1.4rem;border-radius:50px;
text-decoration:none;font-size:.65rem;font-weight:700;
transition:var(--transition);
}
.book-day-card .book-actions .btn-read{
background:linear-gradient(135deg,var(--primary),var(--primary-light));
color:#fff;box-shadow:0 4px 15px rgba(10,36,99,.3);
}
.book-day-card .book-actions .btn-read:hover{transform:translateY(-2px);box-shadow:0 8px 25px rgba(10,36,99,.5)}
.book-day-card .book-day-number{
position:absolute;top:15px;left:20px;
font-size:.5rem;font-weight:700;color:var(--text-muted-color);
background:var(--bg-card);padding:.2rem .8rem;
border-radius:50px;border:1px solid var(--border-card);
}

/* ===== کتابخانه ===== */
.library-category{
background:var(--bg-card);backdrop-filter:blur(20px);
border:1px solid var(--border-card);border-radius:var(--radius);
padding:1rem;margin-bottom:.8rem;transition:var(--transition);
box-shadow:var(--shadow);
}
.library-category .cat-header{display:flex;align-items:center;justify-content:space-between;cursor:pointer}
.library-category .cat-header h3{font-size:.8rem;font-weight:800;color:var(--primary);display:flex;align-items:center;gap:.5rem}
.library-category .cat-header .toggle-icon{font-size:.8rem;color:var(--text-muted-color);transition:transform .4s}
.library-category.open .toggle-icon{transform:rotate(180deg)}
.library-category .book-grid{
display:none;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));
gap:.6rem;padding-top:.8rem;
border-top:1px solid var(--border-card);margin-top:.6rem;
}
.library-category.open .book-grid{display:grid}
.book-link{
display:block;background:var(--white);
border:1px solid var(--gray);border-radius:12px;
padding:.4rem .6rem;text-align:center;text-decoration:none;
color:var(--text-dark);font-size:.55rem;font-weight:600;
transition:var(--transition);box-shadow:0 2px 8px rgba(0,0,0,.04);
}
.book-link:hover{transform:translateY(-3px);box-shadow:var(--shadow-hover);border-color:var(--primary);color:var(--primary)}
.book-link .book-icon{display:block;font-size:1.4rem;margin-bottom:.1rem}

/* ===== دانستنی‌ها ===== */
.fact-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:.8rem}
.fact-item{
background:var(--bg-card);border-radius:14px;
padding:.8rem 1rem;box-shadow:var(--shadow);
border-right:3px solid var(--gold);
font-size:.6rem;color:var(--text-color);line-height:1.8;
transition:var(--transition);
}
.fact-item:hover{transform:translateX(-4px);box-shadow:var(--shadow-hover)}
.fact-item::before{content:'💡 ';font-size:.8rem}

/* ===== افتخارات ===== */
.stats-bottom{
background:var(--bg-card);padding:2rem 0;
border-top:1px solid var(--border-card);
border-bottom:1px solid var(--border-card);
}
.stats-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:1.5rem;text-align:center}
.stats-grid .stat-item h3{font-size:1.8rem;font-weight:900;color:var(--primary);line-height:1.2}
.stats-grid .stat-item h3 span{color:var(--gold)}
.stats-grid .stat-item p{font-size:.6rem;color:var(--text-muted-color);font-weight:500}

/* ===== فوتر ===== */
.footer{
background:var(--footer-bg);color:rgba(255,255,255,.8);
padding:3rem 1.5rem 1.5rem;margin-top:2rem;
}
.footer-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:2rem;max-width:1200px;margin:0 auto}
.footer-grid h4{color:#fff;font-size:.8rem;font-weight:700;margin-bottom:.6rem}
.footer-grid p,.footer-grid a{
font-size:.6rem;color:rgba(255,255,255,.7);
text-decoration:none;display:block;margin:.2rem 0;transition:var(--transition);
}
.footer-grid a:hover{color:var(--gold)}
.footer-bottom{
border-top:1px solid rgba(255,255,255,.08);
margin-top:2rem;padding-top:1.2rem;text-align:center;
font-size:.5rem;color:rgba(255,255,255,.4);
max-width:1200px;margin-left:auto;margin-right:auto;
}

/* ===== ریسپانسیو ===== */
@media(max-width:768px){
.top-bar{padding:.2rem .8rem;font-size:.5rem;justify-content:center}
.header{padding:.5rem .8rem}
.header .logo h1{font-size:.85rem}
.header .logo .logo-icon{width:38px;height:38px;font-size:1.1rem}
.nav-menu{display:none;width:100%;flex-direction:column;align-items:center;gap:.2rem;padding:.5rem 0;border-top:1px solid var(--border-card);margin-top:.4rem}
.nav-menu.open{display:flex}
.nav-menu a{width:100%;text-align:center;padding:.4rem}
.menu-toggle{display:block}
.settings-group{width:100%;justify-content:center;margin-top:.3rem}
.hero{padding:2rem 1rem}
.hero h1{font-size:1.5rem}
.news-card{min-width:200px}
.glass-grid{grid-template-columns:repeat(auto-fill,minmax(110px,1fr));gap:.6rem}
.library-category .book-grid{grid-template-columns:repeat(auto-fill,minmax(100px,1fr))}
.fact-grid{grid-template-columns:1fr}
.footer-grid{grid-template-columns:1fr 1fr;gap:1.2rem}
.stats-grid{grid-template-columns:repeat(2,1fr);gap:1rem}
.book-day-card{padding:1.2rem}
.book-day-card .book-title{font-size:1.1rem}
.book-icon-3d{width:90px;height:90px}
.book-icon-3d .book{width:60px;height:75px}
}

@media(max-width:480px){
.hero h1{font-size:1.2rem}
.glass-grid{grid-template-columns:repeat(3,1fr)}
.footer-grid{grid-template-columns:1fr;text-align:center}
}
</style>
