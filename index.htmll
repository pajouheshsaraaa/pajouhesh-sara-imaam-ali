<script>
// ===== منو =====
function toggleMenu(){
document.getElementById('navMenu').classList.toggle('open');
}
document.querySelectorAll('.nav-menu a').forEach(a=>{
a.addEventListener('click',()=>{
document.getElementById('navMenu').classList.remove('open');
});
});

// ===== باز و بسته کردن بخش‌ها =====
function toggleSection(id){
const c=document.getElementById(id);
const b=c.previousElementSibling;
c.classList.toggle('open');
b.classList.toggle('active');
}

function togglePole(e){
e.closest('.pole-item').classList.toggle('open');
}

function toggleCategory(e){
e.closest('.library-category').classList.toggle('open');
}

// ===== تغییر حالت تیره/روشن =====
function toggleTheme(){
const h=document.documentElement;
const b=document.getElementById('themeToggle');
if(h.getAttribute('data-theme')==='dark'){
h.removeAttribute('data-theme');
b.innerHTML='<i class="fas fa-moon"></i>';
b.classList.remove('active');
}else{
h.setAttribute('data-theme','dark');
b.innerHTML='<i class="fas fa-sun"></i>';
b.classList.add('active');
}
}

// ===== تغییر زبان =====
function toggleLang(){
const h=document.documentElement;
const l=document.getElementById('langLabel');
if(h.getAttribute('data-lang')==='en'){
h.removeAttribute('data-lang');
l.textContent='فا';
}else{
h.setAttribute('data-lang','en');
l.textContent='En';
}
}

