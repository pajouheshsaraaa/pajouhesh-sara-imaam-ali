// ===== نمایش خبر =====
function showNews(id){
const data=newsData[id];
if(!data)return;
const ov=document.createElement('div');
ov.style.cssText='position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,.7);backdrop-filter:blur(12px);z-index:9999;display:flex;align-items:center;justify-content:center;padding:1.5rem';
const m=document.createElement('div');
m.style.cssText='max-width:600px;width:100%;background:var(--bg-card);border-radius:28px;padding:2rem;position:relative;box-shadow:0 20px 60px rgba(0,0,0,.4);border:1px solid var(--border-card);color:var(--text-color);max-height:85vh;overflow-y:auto';

let imgHTML=data.image?`<img src="${data.image}" style="width:100%;border-radius:16px;margin-bottom:1rem" onerror="this.style.display='none'">`:'';
let linksHTML='';
if(data.links){
data.links.forEach(l=>{
linksHTML+=`<a href="${l.url}" target="_blank" style="display:inline-block;margin:0.3rem;padding:0.4rem 1rem;background:var(--primary);color:#fff;border-radius:50px;text-decoration:none;font-size:0.6rem;font-weight:700">${l.text}</a>`;
});
}

m.innerHTML=`
<button onclick="this.closest('div[style]').remove()" style="position:absolute;top:12px;left:16px;background:#f1f5f9;border:none;width:36px;height:36px;border-radius:50%;font-size:1.2rem;cursor:pointer;color:#0f172a;z-index:10">✕</button>
<span style="display:inline-block;font-size:0.6rem;font-weight:700;color:var(--primary);background:rgba(10,36,99,0.08);padding:0.1rem 0.8rem;border-radius:50px;margin-bottom:0.5rem">${data.badge}</span>
<h2 style="font-size:1.1rem;font-weight:800;color:var(--primary);margin:0.3rem 0 0.6rem;line-height:1.5">${data.title}</h2>
${imgHTML}
<div style="font-size:0.75rem;line-height:2;color:var(--text-color);white-space:pre-wrap;word-wrap:break-word;max-height:45vh;overflow-y:auto">${data.content}</div>
<div style="font-size:0.5rem;color:var(--text-muted-color);margin-top:0.8rem;padding-top:0.8rem;border-top:1px solid var(--border-card)">📅 ${data.date}</div>
<div style="margin-top:0.5rem">${linksHTML}</div>
`;
ov.appendChild(m);
document.body.appendChild(ov);
ov.addEventListener('click',e=>{if(e.target===ov)ov.remove()});
}

