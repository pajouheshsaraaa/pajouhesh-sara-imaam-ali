// ===== لود کتاب امروز =====
function loadBookOfDay(){
const today=new Date();
const dayOfYear=Math.floor((today-new Date(today.getFullYear(),0,0))/86400000);
const bookIndex=dayOfYear%books.length;
const book=books[bookIndex];

document.getElementById('bookDayNumber').textContent=`روز ${bookIndex+1} از ${books.length}`;
document.getElementById('bookCategory').textContent=book.cat;
document.getElementById('bookTitle').textContent=book.title;
document.getElementById('bookAuthor').textContent=book.author;
document.getElementById('bookDesc').textContent=book.desc;

// جستجو در گوگل
const searchQuery=encodeURIComponent(book.title+' '+book.author+' دانلود کتاب');
document.getElementById('bookReadLink').href=`https://www.google.com/search?q=${searchQuery}`;
}

loadBookOfDay();
</script>

